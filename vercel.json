{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix client install && npm --prefix client run build && npx --yes esbuild@0.24.0 server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/dist/app.js",
  "outputDirectory": "client/dist",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/dist/**"
    }
  },
  "crons": [{ "path": "/api/cron/keepalive", "schedule": "0 12 * * *" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/ready", "destination": "/api" },
    { "source": "/ads.txt", "destination": "/api" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}

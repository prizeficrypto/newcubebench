# Copy to .env and fill in. DATABASE_URL is required; the rest are optional.
# Without the optional ones: email + password sign-in works, Google and WCA
# sign-in stay hidden, and no ads are served.

# --- Database (Supabase / Postgres) — REQUIRED ---
# Supabase → Project Settings → Database → Connection string → "Transaction"
# pooler (port 6543). Paste it with your DB password filled in.
DATABASE_URL=

# --- Google sign-in (same value as client VITE_GOOGLE_CLIENT_ID) ---
# https://console.cloud.google.com/apis/credentials  (Web application)
GOOGLE_CLIENT_ID=

# --- WCA account connect / sign-in (free) ---
# Register an app at https://www.worldcubeassociation.org/oauth/applications
# Redirect URI: <APP_URL>/auth/wca   (e.g. http://localhost:5173/auth/wca)
# Scopes: public
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# --- Google AdSense ---
# Your publisher id, e.g. pub-1234567890123456. Serves /ads.txt.
# (The client also needs VITE_ADSENSE_CLIENT — see client/.env.example.)
ADSENSE_PUBLISHER_ID=

# Public base URL of the app (OAuth redirects):
APP_URL=http://localhost:5173

# Vercel Cron secret for /api/cron/keepalive (any long random string).
CRON_SECRET=
